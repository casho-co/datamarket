# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@host.neon.tech/datalayer-market

# BSC Chain
BSC_RPC_URL=https://bsc-dataseed.binance.org/
PLATFORM_BSC_PRIVATE_KEY=0x...
PLATFORM_BSC_ADDRESS=0x...

# Contract Addresses (BSC Mainnet defaults)
USDC_BSC_ADDRESS=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
ERC8004_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# Cron Security
CRON_SECRET=your-cron-secret-here

# Upstash Redis (rate limiting, nonce tracking, idempotency)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Cloudflare R2 (file storage)
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=datalayer-market-deliverables

# Webhook
WEBHOOK_SECRET=your-webhook-signing-secret

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
